{
  "lock": true,
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "include": ["scripts/", "extension/"],
    "proseWrap": "never"
  },
  "lint": {
    "include": ["scripts/", "extension/"]
  },
  "imports": {
    "@std/cli/parse-args": "jsr:@std/cli@1.0.32/parse-args",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/toml": "jsr:@std/toml@1.0.11",
    "fflate": "npm:fflate@0.8.3/browser"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check --frozen scripts/*.ts",
    "check-schema": "deno run --frozen --allow-read --allow-write --allow-run scripts/check-schema.ts",
    "verify-version": "deno run --frozen --allow-read --allow-write --allow-env=GITHUB_REF_NAME,GITHUB_OUTPUT scripts/verify-version.ts",
    "package": "deno run --frozen --allow-read --allow-write --allow-env=GITHUB_OUTPUT scripts/package.ts",
    "package-extension": "deno run --frozen --allow-read --allow-write=target/extension scripts/package-extension.ts",
    "preview-screenshots": "deno run --frozen --allow-read --allow-write=target/m3-screenshots --allow-env=QUARTZ_PREVIEW_THEME,QUARTZ_PREVIEW_STATE,QUARTZ_PREVIEW_LANG,QUARTZ_PREVIEW_OFFSCREEN,QUARTZ_PREVIEW_SIZE,QUARTZ_PREVIEW_TEXT_SCALE,QUARTZ_PREVIEW_MICA_FALLBACK,QUARTZ_PREVIEW_HIGH_CONTRAST,QUARTZ_PREVIEW_DIAGNOSTICS --allow-ffi scripts/preview-screenshots.ts",
    "measure": "deno run --frozen --allow-ffi --allow-run --allow-read --allow-write --allow-env=LOCALAPPDATA scripts/measure.ts",
    "acceptance-summary": "deno run --frozen --allow-read scripts/acceptance-summary.ts",
    "acceptance-reject": "deno run --frozen --allow-run=powershell.exe scripts/acceptance-reject.ts",
    "acceptance": "deno run --frozen --allow-read scripts/acceptance.ts",
    "test": "deno test --frozen scripts/*_test.ts extension/src/*_test.js"
  }
}
